# Copiá este archivo a .env y completá los valores. .env está en .gitignore.

# --- Modelo de IA ---
# Proveedor: openrouter, gemini (Google) o anthropic (Claude). Si se deja vacío, usa el que tenga API key.
AGENTE_PROVEEDOR=

# Gemini: clave gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter: clave en https://openrouter.ai/keys (hay modelos gratuitos terminados en :free)
OPENROUTER_API_KEY=

# --- Claude (Anthropic) ---
# Si falta, el modo demo reproduce las respuestas grabadas en data/grabaciones/.
ANTHROPIC_API_KEY=
# Opcional: modelo a usar (por defecto claude-opus-5-5, gemini-3.6-flash o nvidia/nemotron-3-super-120b-a12b:free)
# AGENTE_MODELO=
# Opcional: un modelo distinto por agente (pisa a AGENTE_MODELO; tiene que ser del proveedor elegido)
AGENTE_MODELO_CONTEXTO=
AGENTE_MODELO_INTERPRETE=
AGENTE_MODELO_ANALISTA=
AGENTE_MODELO_DESVIOS=

# --- Notion (solo modo conectado) ---
# Integración interna compartida SOLO con la página del producto.
NOTION_TOKEN=

# --- Jira Cloud (solo modo conectado) ---
JIRA_BASE_URL=https://tu-sitio.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
